From afe6f251102bf9d6b1f813a9e91f2ec684954bd2 Mon Sep 17 00:00:00 2001
From: twongjirad <taritree.wongjirad@gmail.com>
Date: Wed, 11 Nov 2026 14:45:24 -0500
Subject: [PATCH] Tufts sim production: all-plane SimChannel with IDE xyz; CRT
 hit/track scan without DAQ header

Changes used to make the Tufts corsika+BNB training samples
(NuTufts/uboone_on_tufts, nu_and_cosmics), built against
uboonecode v08_00_00_40a_dl e17:prof.

- ScannerAlgo.template.h: keep SimChannels for all three planes (drop the
  Channel() < 4800 skip that kept only the Y plane) and fill the larlite
  IDE x,y,z. Add ScanData specializations for crt::CRTHit and
  crt::CRTTrack that do not need a DAQHeaderTimeUBooNE.
- LiteScanner_module.cc: ScanDataCRT falls back to the no-GPS-time
  ScanData path when the DAQ header is missing (pure MC) instead of
  returning without storing CRT products.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0194U1FJGCJZxLC7jZ9YgfZs
---
 ublite/LiteMaker/LiteScanner_module.cc  |  32 ++++++--
 ublite/LiteMaker/ScannerAlgo.template.h | 102 ++++++++++++++++++++++--
 2 files changed, 121 insertions(+), 13 deletions(-)

diff --git a/ublite/LiteMaker/LiteScanner_module.cc b/ublite/LiteMaker/LiteScanner_module.cc
index 3d48b840..513ace54 100644
--- a/ublite/LiteMaker/LiteScanner_module.cc
+++ b/ublite/LiteMaker/LiteScanner_module.cc
@@ -639,7 +639,8 @@ template<class T> void LiteScanner::ScanData(const art::Event& evt, const size_t
     art::InputTag inputtag(label);
     evt.getByLabel(inputtag, dh);
 
-    if(dh.isValid()) fAlg.ScanData(dh,lite_data);
+    if(dh.isValid()) 
+      fAlg.ScanData(dh,lite_data);
 
     for ( unsigned int cat=0; cat<(unsigned int)opdet::NumUBOpticalChannelCategories; cat++ ) {
       
@@ -655,7 +656,10 @@ template<class T> void LiteScanner::ScanData(const art::Event& evt, const size_t
     art::InputTag inputtag(label);
     evt.getByLabel(inputtag, dh);
     
-    if(!dh.isValid()) return;
+    if(!dh.isValid())  {
+      std::cout << "Skip scanning of data with label=" << label << std::endl;
+      return;
+    }
     fAlg.ScanData(dh,lite_data);
   }
 }
@@ -681,20 +685,32 @@ template<class T> void LiteScanner::ScanDataCRT(const art::Event& evt, const siz
   art::InputTag inputtag2(fDAQHeaderTimeUBooNE);
   evt.getByLabel(inputtag2, ddh);
   
-  if(!dh.isValid() || !ddh.isValid()) {
+  if(!dh.isValid()) {
     std::stringstream msg;
     msg << "[" << __FILE__ << ".L" << __LINE__ << "::" << __FUNCTION__ << "] "
-	<< "invalid handles. crthit/track=" << dh.isValid() << " daqheader=" << ddh.isValid()
+	<< "invalid handles. crthit/track=" << dh.isValid() 
 	<< std::endl;
     std::cout << "[WARNING]: " << msg.str();
     //throw cet::exception(msg.str());
     return;
   }
-  // std::cout << "[" << __FILE__ << ".L" << __LINE__ << "::" << __FUNCTION__ << "] "
-  // 	    << " run ScanDataTest(crthit/track,daqheader,lite_data)"
-  // 	    << std::endl;
-  fAlg.ScanDataTest(dh,ddh,lite_data);
+  
+  if ( !ddh.isValid()) {
+    std::stringstream msg;
+    msg << "[" << __FILE__ << ".L" << __LINE__ << "::" << __FUNCTION__ << "] " << " invalid daqheader=" << ddh.isValid()
+	<< " Process without gps time."
+	<< std::endl;
+    std::cout << "[WARNING]: " << msg.str();
+    fAlg.ScanData(dh,lite_data);
+  }
+  else {
+    std::cout << "[" << __FILE__ << ".L" << __LINE__ << "::" << __FUNCTION__ << "] "
+	      << " run ScanDataTest(crthit/track,daqheader,lite_data)"
+	      << std::endl;
+    fAlg.ScanDataTest(dh,ddh,lite_data);
+  }
 
+  return;
 }
 //
 template<class T> void LiteScanner::ScanDataDAQTime(const art::Event& evt, const size_t name_index)
diff --git a/ublite/LiteMaker/ScannerAlgo.template.h b/ublite/LiteMaker/ScannerAlgo.template.h
